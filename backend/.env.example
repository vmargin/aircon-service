# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit a filled-in .env.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Postgres connection string. Local docker, Railway, Neon, or Supabase.
DATABASE_URL="postgresql://postgres:password@localhost:5432/aircon_service"

# JWT signing secret. Must be 32+ chars in production. Generate one with:
#   node backend/scripts/generate-jwt-secret.js
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Optional (sensible defaults) -------------------------------------------

PORT=5000
NODE_ENV="development"

# CORS. Only needed when the frontend is hosted on a DIFFERENT origin than the
# API. In the default single-service deploy the API serves the built frontend
# itself, so leave this unset.
# FRONTEND_URL="https://your-frontend.example.com"

JWT_EXPIRES_IN="24h"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes
RATE_LIMIT_LOGIN_MAX=5          # login attempts per window per IP
RATE_LIMIT_GENERAL_MAX=600      # authed API requests per window

# Trust the reverse proxy (Railway/Vercel/Fly) so rate limiting sees real IPs.
TRUST_PROXY=1

# Audit logging
AUDIT_LOG_ENABLED=true

# Seed script only — password given to the demo users it creates.
DEMO_ADMIN_PASSWORD="demo1234"
