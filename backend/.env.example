# ---------------------------------------------------------------------------
# Copy to .env and fill in real values. NEVER commit a filled-in .env.
# ---------------------------------------------------------------------------

# Postgres connection string (pooled). Supabase, Neon, Railway, or local docker.
DATABASE_URL="postgresql://user:password@localhost:5432/aircon_service"
# Direct (non-pooled) connection — required by Prisma Migrate on Supabase/Neon.
DIRECT_URL="postgresql://user:password@localhost:5432/aircon_service"

# Server
PORT=5000
NODE_ENV="development"

# CORS — the browser origin allowed to call this API. Required in production.
FRONTEND_URL="http://localhost:5173"

# JWT signing secret. Must be 32+ chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="24h"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes
RATE_LIMIT_LOGIN_MAX=5          # login attempts per window per IP
RATE_LIMIT_PUBLIC_BOOKING_MAX=10
RATE_LIMIT_GENERAL_MAX=600      # authed API requests per window

# Trust the reverse proxy (Railway/Vercel/Fly) so rate limiting sees real IPs.
TRUST_PROXY=1

# Audit logging
AUDIT_LOG_ENABLED=true

# Seed script only — password given to the demo users it creates.
DEMO_ADMIN_PASSWORD="demo123"
