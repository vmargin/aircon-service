datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  BRANCH_LEADER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ON_SITE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Organization {
  id        String   @id @default(uuid())
  name      String   @unique
  branches  Branch[]
  users     User[]
  customers Customer[]
}

model Branch {
  id             String   @id @default(uuid())
  name           String
  location       String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  users          User[]
  technicians    Technician[]
  bookings       Booking[]
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password       String
  role           UserRole      @default(BRANCH_LEADER)
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  branch         Branch?       @relation(fields: [branchId], references: [id])
  branchId       String?
  auditLogs      AuditLog[]
}

model Technician {
  id       String    @id @default(uuid())
  name     String
  phone    String?
  branch   Branch    @relation(fields: [branchId], references: [id])
  branchId String
  bookings Booking[]
  isActive Boolean   @default(true)
}

model Customer {
  id             String   @id @default(uuid())
  name           String
  phone          String
  address        String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  bookings       Booking[]
}

model Booking {
  id            String        @id @default(uuid())
  serviceType   String // e.g., "Cleaning", "Repair", "Installation"
  status        BookingStatus @default(PENDING)
  scheduledAt   DateTime
  customer      Customer      @relation(fields: [customerId], references: [id])
  customerId    String
  branch        Branch        @relation(fields: [branchId], references: [id])
  branchId      String
  technician    Technician?   @relation(fields: [technicianId], references: [id])
  technicianId  String?
  invoice       Invoice?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Invoice {
  id            String        @id @default(uuid())
  amount        Float // SQLite doesn't support Decimal, Float is fine for demo
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String? // "CASH", "E_WALLET", "BANK", "CHEQUE"
  booking       Booking       @relation(fields: [bookingId], references: [id])
  bookingId     String        @unique
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       String // e.g. BOOKING_CREATE, BOOKING_UPDATE, INVOICE_CREATE, TECHNICIAN_DEACTIVATE
  resourceType String // booking, invoice, technician
  resourceId   String
  branchId     String? // branch the resource belongs to (for branch-scoped views)
  details      String? // optional JSON or short description
  createdAt    DateTime @default(now())
}
