{
  "name": "aircon-service-backend",
  "version": "2.0.0",
  "description": "Backend API for Aircon Service Management System",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration --runInBand",
    "test:integration:watch": "jest tests/integration --runInBand --watch",
    "test:integration:coverage": "jest tests/integration --runInBand --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "build": "tsc",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "db:validate": "prisma validate"
  },
  "keywords": [
    "aircon",
    "service",
    "management",
    "backend",
    "nodejs",
    "express",
    "typescript"
  ],
  "author": "Arctic Aircon",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-jwt": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^4.0.0",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.4",
    "@types/supertest": "^2.0.16",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^6.19.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  }
}
